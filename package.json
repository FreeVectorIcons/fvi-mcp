{
  "name": "@freevectoricons/mcp",
  "version": "0.2.0-beta.2",
  "description": "Beta MCP server for FreeVectorIcons design collections",
  "author": "Hemanta Sapkota <hemanta@freevectoricons.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreeVectorIcons/fvi-mcp.git"
  },
  "homepage": "https://freevectoricons.com/mcp",
  "bugs": {
    "url": "https://github.com/FreeVectorIcons/fvi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "freevectoricons",
    "svg",
    "icons",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "fvi-mcp": "dist/mcp-server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "prepublishOnly": "node ./build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node ./scripts/smoke.mjs",
    "audit:consumer": "npm audit --omit=dev --audit-level=moderate",
    "audit:maintainer": "npm audit --audit-level=high"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^25.3.3",
    "esbuild": "0.28.2",
    "typescript": "~5.9.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "qs": "6.16.0"
  }
}
