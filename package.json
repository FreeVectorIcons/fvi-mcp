{
  "name": "@freevectoricons/mcp",
  "mcpName": "io.github.FreeVectorIcons/fvi-mcp",
  "version": "0.3.0-beta.2",
  "description": "Beta MCP server for FreeVectorIcons design collections",
  "author": "Hemanta Sapkota <hemanta@freevectoricons.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreeVectorIcons/fvi-mcp.git"
  },
  "homepage": "https://freevectoricons.com/mcp",
  "bugs": {
    "url": "https://github.com/FreeVectorIcons/fvi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "freevectoricons",
    "svg",
    "icons",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "fvi-mcp": "dist/mcp-server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "prepublishOnly": "node ./build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node ./scripts/smoke.mjs",
    "contract": "node ./scripts/contract.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "hosts": "node ./scripts/generate-host-files.mjs",
    "hosts:check": "node ./scripts/generate-host-files.mjs --check",
    "pack-check": "node ./scripts/pack-check.mjs",
    "compat:gemini": "node ./scripts/gemini-schema-check.mjs",
    "audit:consumer": "npm audit --omit=dev --audit-level=moderate",
    "audit:maintainer": "npm audit --audit-level=high"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^25.3.3",
    "esbuild": "0.28.2",
    "typescript": "~5.9.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
